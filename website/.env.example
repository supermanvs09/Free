# Canonical origin for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://deepalgorithms.io
# Form API (demo + contact). Defaults to the endpoint the current site uses,
# which is an API Gateway "/dev" stage. Point it at production before launch.
VITE_FORM_ENDPOINT=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Empty = no analytics.
# Turning this on means the site sets analytics cookies: update the cookie
# policy and add consent first (see docs/redesign/HANDOFF.md).
VITE_GA_ID=
# Google Search Console HTML-tag verification token (content="..." value).
VITE_GSC_VERIFICATION=
