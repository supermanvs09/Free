# Local development only (npm run dev). Copy to .env - it is git-ignored.

# ── Console (build time) ──────────────────────────────────────────────────
# Simulated response time of the built-in API, in ms (0 = instant).
VITE_LOCAL_LATENCY=180
# Where the browser reaches the notification relay. Same-origin by default.
VITE_NOTIFY_API=/notify-api

# ── Notification relay (npm run relay; in production, the container env) ──
# The verified SES identity alert email is sent from. Required for email.
MAIL_FROM=alerts@deepalgorithms.ai
MAIL_FROM_NAME=NHI Security
AWS_REGION=ap-south-1
# Optional: only email these domains (comma separated).
ALLOWED_RECIPIENT_DOMAINS=
# Optional: a server-side Jira account, used instead of the one entered in the console.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Where `npm run dev` proxies /notify-api.
NOTIFY_RELAY_URL=http://127.0.0.1:8787
