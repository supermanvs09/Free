# Copy to .env (git-ignored) and fill in real values. Never commit secrets.

# ClickHouse (CloudTrail events) — optional. Leave NHI_CLICKHOUSE_HOST empty to
# run on Postgres data only. Use read-only credentials.
NHI_CLICKHOUSE_HOST=
NHI_CLICKHOUSE_PORT=9000
# native (TCP 9000/9440) or http (8123/8443)
NHI_CLICKHOUSE_PROTOCOL=native
# Leave NHI_CLICKHOUSE_DATABASE empty for one database per tenant: <tenant db_name><suffix>,
# e.g. bimasugam_clickhouse (the app user needs read access to each). Set it to pin one database.
NHI_CLICKHOUSE_DATABASE=
# NHI_CLICKHOUSE_DATABASE_SUFFIX=_clickhouse
NHI_CLICKHOUSE_USER=
NHI_CLICKHOUSE_PASSWORD=
NHI_CLICKHOUSE_TABLE=cloudtrail_events
NHI_CLICKHOUSE_TIMEOUT_SECONDS=5
# Set true for TLS (usually port 9440).
NHI_CLICKHOUSE_SECURE=false

# PostgreSQL — single database (nhi_db). Tenants are schemas inside it.
NHI_DB_HOST=
NHI_DB_NAME=nhi_db
NHI_DB_USER=
NHI_DB_PASSWORD=
# Global/auth schema holding nhi_user + tenant.
NHI_GLOBAL_SCHEMA=nhi_global
NHI_JWT_SECRET=
# Optional overrides (defaults come from config.yaml: 60 min / 168 h)
# NHI_JWT_ACCESS_TTL_MINUTES=60
# NHI_JWT_REFRESH_TTL_HOURS=168
# NHI_JWT_SESSION_MAX_HOURS=720

# Connect AWS Account (Integrations page) - optional overrides of the
# aws_integration block in configs/config.yaml. No AWS keys: the SDK default
# chain is used (task role / instance profile, or AWS_PROFILE locally).
# NHI_AWS_ASSUME_ASSUMER_ROLE=false
# NHI_AWS_ASSUMER_ROLE_NAME=NHIPlatformAssumer
# NHI_AWS_COLLECTOR_ROLE_NAME=NHIPlatformCollector
# NHI_AWS_FORWARD_RULE_NAME=nhi-forward-activity
# The customer's role EventBridge uses to put events on our bus, and the trail
# name the setup suggests when the account has no qualifying trail:
# NHI_AWS_FORWARD_ROLE_NAME=NHIEventBridgeForwardRole
# NHI_AWS_TRAIL_NAME=adapid-nhi-trail
# NHI_AWS_GITHUB_SECRET_PREFIX=nhi/github
# NHI_GITHUB_API_URL=https://api.github.com
# REQUIRED for the "Receive your events" check (the only event source):
# the SQS queue in our account that a rule on the central bus delivers to.
# NHI_AWS_EVENT_QUEUE_URL=https://sqs.<region>.amazonaws.com/<our account>/<queue name>
# The events check polls that queue every N seconds (5-10, default 7) until
# an event from every region the customer chose (and us-east-1, where IAM and
# STS report) has arrived, for at most M minutes (default 15):
# NHI_AWS_EVENT_POLL_SECONDS=7
# NHI_AWS_EVENT_WAIT_MINUTES=15

# Connection approval. A first connection that passes every check waits for a
# super admin on the tenant-onboarding Approvals page; these people get an
# e-mail as soon as it does. Comma-separated. Leave empty and no e-mail is
# sent (the Approvals page still shows the request, with "not configured").
CONNECTION_APPROVAL_EMAILS=
# Link in that e-mail to the Approvals page:
# APPROVALS_URL=https://onboarding.example.com/#/approvals
# SMTP for it (shared with remediation notifications). SMTP_TLS: starttls
# (default) | tls | none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
EMAIL_FROM=

# Development only: stand a simulator in for AWS, so the whole connect flow
# (checks, events watch, approval, e-mail) can be tried with no AWS account.
# Refused when NHI_ENV=production. Account 000000000401 fails assume,
# 000000000403 fails the read, 000000000404 never sends events.
# NHI_AWS_SIMULATE=true
# NHI_AWS_SIMULATE_EVENT_EVERY=6s
# Unused by the events check now (kept for older configs):
# NHI_AWS_EVENT_LOG_GROUP=
# NHI_AWS_EVENT_LOOKBACK_HOURS=24
# NHI Genome — behaviour-monitoring ClickHouse (the pipeline's log_events table).
# Separate from NHI_CLICKHOUSE_* above. Leave NHI_MONITORING_CLICKHOUSE_HOST empty
# to disable: the event-backed fields of the genome endpoints are then null.
# Use read-only credentials.
NHI_MONITORING_CLICKHOUSE_HOST=
# http (8123/8443) or native (9000/9440)
NHI_MONITORING_CLICKHOUSE_PROTOCOL=http
NHI_MONITORING_CLICKHOUSE_PORT=8123
# Empty = per tenant (<db_name>_clickhouse), same rule as NHI_CLICKHOUSE_DATABASE.
NHI_MONITORING_CLICKHOUSE_DATABASE=
# NHI_MONITORING_CLICKHOUSE_DATABASE_SUFFIX=_clickhouse
NHI_MONITORING_CLICKHOUSE_TABLE=log_events
NHI_MONITORING_CLICKHOUSE_USER=
NHI_MONITORING_CLICKHOUSE_PASSWORD=
# Set true for TLS (usually port 8443/9440).
NHI_MONITORING_CLICKHOUSE_SECURE=false
NHI_MONITORING_CLICKHOUSE_TIMEOUT_SECONDS=5

# Logging (stdout). json is for log shippers, text is easier to read locally.
# NHI_LOG_LEVEL=info
# NHI_LOG_FORMAT=json
# NHI_SLOW_QUERY_MS=1000

# ISPM rule engine (the separately deployed ispm-worker that runs posture scans).
# WORKER_URL is its scan API (ENGINE_HEALTH_PORT), never this server's own port.
# WORKER_SCAN_TOKEN = the worker's SCAN_API_TOKEN, used by the console's Sync
# button; the public POST /api/v1/scans uses the key the caller sends instead.
# WORKER_URL=http://ispm-worker:8090
# WORKER_SCAN_TOKEN=
# NHI_WORKER_TIMEOUT_SECONDS=10

# NHI Genome: which workload kinds to show. Comma-separated source families; empty = all.
# Known: APP_RUNNER, AWS_SLR, BATCH, BEDROCK, CLOUDFORMATION, CODEBUILD, CODEDEPLOY, CODEPIPELINE, DATASYNC, DMS, EC2, ECS, ELASTIC_BEAN, EMR, EVENTBRIDGE, GLUE, IAM, IOT, KINESIS, LAMBDA, MWAA, SAGEMAKER, SSM, STEP_FUNCTIONS, SYNTHETICS, TRANSFER
# NHI_GENOME_WORKLOAD_TYPES=ECS,EC2,GLUE,LAMBDA,STEPFUNCTION
