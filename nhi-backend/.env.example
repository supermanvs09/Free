# NHI backend (api-server) settings. Copy to .env (git-ignored) and fill in.
# Everything not listed here has a sensible default in configs/config.yaml or
# in code. Never commit real secrets. No AWS keys go here: the server uses its
# own IAM role (ECS task role / EC2 instance profile) for every AWS call.

# ── Runtime ────────────────────────────────────────────────────────────────
NHI_ENV=production
NHI_CONFIG_FILE=configs/config.yaml
# Browser origins allowed to call the API (comma-separated): the console URL.
NHI_CORS_ALLOWED_ORIGINS=https://console.example.com
# json for log shippers; text is easier to read locally.
NHI_LOG_LEVEL=info
NHI_LOG_FORMAT=json

# ── PostgreSQL (one database; each tenant is a schema in it) ───────────────
NHI_DB_HOST=
NHI_DB_NAME=nhi_db
NHI_DB_USER=
NHI_DB_PASSWORD=
NHI_GLOBAL_SCHEMA=nhi_global

# ── Sign-in ────────────────────────────────────────────────────────────────
# A long random string (e.g. openssl rand -base64 48).
NHI_JWT_SECRET=

# ── AWS ────────────────────────────────────────────────────────────────────
# Region of our own AWS services (SQS queue, SES, remediation sessions).
AWS_REGION=ap-south-1
# SQS queue in our account that the central event bus delivers to. Required
# for the "Events arrive from each region" check, so accounts can connect.
NHI_AWS_EVENT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<our-account-id>/<queue-name>

# ── E-mail (Amazon SES only) ───────────────────────────────────────────────
# Sender: an address or domain verified in SES. Empty turns all e-mail off.
# The server's IAM role needs ses:SendEmail. Leave the SES account in sandbox
# mode only if every recipient below is verified in SES too.
EMAIL_FROM=noreply@example.com
SES_REGION=ap-south-1
# Told once, when the workspace's FIRST AWS account is verified: it waits for
# approval in the tenant-onboarding tool. Re-checks and later accounts of an
# approved workspace send no e-mail and need no approval. Every click is stored
# in nhi_global.connection_requests with the customer's AWS account id.
CONNECTION_APPROVAL_EMAILS=
# Remediation mail: approvers of plans, and who gets results / the digest.
EMAIL_APPROVERS=
EMAIL_NOTIFY=

# ── ISPM rule engine (ispm-worker), used by Sync now ───────────────────────
WORKER_URL=http://ispm-worker:8090
WORKER_SCAN_TOKEN=

# ── Remediation ────────────────────────────────────────────────────────────
REMEDIATION_ENABLED=true
# Console URL, used in links inside remediation e-mails and Jira tickets.
DASHBOARD_BASE_URL=https://console.example.com
# Optional: a role the platform assumes before the customer's role.
AWS_PLATFORM_ROLE_ARN=
# Optional Jira tickets for findings (token is read from JIRA_API_TOKEN).
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_PROJECT_KEY=
JIRA_API_TOKEN=
# Optional (new with the ISPM remediation update): the tenant table that holds
# the AWS accounts and their remediation settings, shared with the rule
# engine (default accounts), and a comma-separated list of tenant db_names or
# ids to limit remediation to (empty = every tenant).
ACCOUNTS_TABLE=accounts
REMEDIATION_TENANTS=

# ── ClickHouse: CloudTrail events (optional; empty host = off) ─────────────
# Empty database = one per tenant: <tenant db_name>_clickhouse.
NHI_CLICKHOUSE_HOST=
NHI_CLICKHOUSE_PORT=9000
NHI_CLICKHOUSE_PROTOCOL=native
NHI_CLICKHOUSE_DATABASE=
NHI_CLICKHOUSE_USER=
NHI_CLICKHOUSE_PASSWORD=
NHI_CLICKHOUSE_SECURE=false

# ── ClickHouse: NHI Genome behaviour monitoring (optional; empty host = off) ─
NHI_MONITORING_CLICKHOUSE_HOST=
NHI_MONITORING_CLICKHOUSE_PORT=8123
NHI_MONITORING_CLICKHOUSE_PROTOCOL=http
NHI_MONITORING_CLICKHOUSE_DATABASE=
NHI_MONITORING_CLICKHOUSE_USER=
NHI_MONITORING_CLICKHOUSE_PASSWORD=
NHI_MONITORING_CLICKHOUSE_SECURE=false
# NHI Genome identities list (GET /api/v1/genome/identities): which workload
# families to show. Empty = every family, so new kinds (for example IAM users
# used as service accounts) appear as soon as discovery finds them. To limit,
# list families: EC2,LAMBDA,ECS,GLUE,STEP_FUNCTIONS,BATCH,IAM,...
# Last call and call counts in that list need the monitoring ClickHouse above.
NHI_GENOME_WORKLOAD_TYPES=

# Payload encryption on top of HTTPS (see README "Payload encryption"). Off by default.
# PAYLOAD_ENCRYPTION_ENABLED=true
# The private key as one line (no file): openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | grep -v '^-----' | tr -d '\n'
# PAYLOAD_RSA_PRIVATE_KEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASC...
# PAYLOAD_ENCRYPTION_EXEMPT=/api/v1/some-webhook

# Code repositories (GitHub App, Bitbucket Data Center) on the Integrations page.
# Off (default): the card is hidden, its endpoints answer 404 and its tab stays off.
# NHI_GITHUB_SCANNING_ENABLED=false
# NHI_BITBUCKET_SCANNING_ENABLED=false
# The secret scanner's base URL and admin key (server side only), and the GitHub App's install link.
# NHI_SECRET_SCANNER_URL=https://js-dev.adapid.link
# NHI_SECRET_SCANNER_ADMIN_KEY=
# NHI_GITHUB_APP_INSTALL_URL=https://github.com/apps/<app-name>/installations/new
