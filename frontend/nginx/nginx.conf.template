# NHI Console - production web tier.
#
# A template, not the final configuration. The official nginx image runs
# `envsubst` over /etc/nginx/templates/*.template at container start and writes
# the result into /etc/nginx/conf.d, so the upstreams below are chosen at RUN
# time rather than baked into an image layer.
#
# Substituted at start (see NGINX_ENVSUBST_FILTER in the Dockerfile, which
# limits substitution to exactly these names so nginx's own $variables survive
# untouched):
#   API_UPSTREAM          the NHI backend, e.g. http://nhi-api:8080
#   DNS_RESOLVER          127.0.0.11 under Docker, the cluster DNS on K8s
#   DISCOVERY_UPSTREAM    the discovery scan service behind the Sync button
#
# One backend serves every API: discovery under /api/v1, posture under
# /api/v1/ispm and genome under /api/v1/genome. The browser's bearer token is
# forwarded unchanged. In the order a request meets them:
#   1. /api/*          the NHI backend, path unchanged
#   2. everything else the single-page app, with index.html as the fallback so a
#                      deep link survives a hard refresh.

# The upstream is addressed through a variable, which makes nginx resolve
# them per request instead of at startup. Without this, a compose stack whose
# API container has not come up yet would prevent nginx from starting at all -
# the web tier should serve its own error states, not fail to boot.
resolver ${DNS_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

server {
    # IPv4 only, deliberately. `listen [::]:3000` makes nginx refuse to start
    # outright on a host without IPv6 - which includes many container runtimes
    # and CI environments - and a container bound to 0.0.0.0 is reachable in a
    # dual-stack network anyway, because the runtime maps the published port.
    # Add the IPv6 line only where IPv6 is known to be present.
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the version to anyone probing the service.
    server_tokens off;

    # Uploads are not a feature of this app; its writes are small JSON bodies.
    client_max_body_size 1m;

    # Compress what benefits from it. Images and fonts arrive compressed
    # already, so re-compressing them only burns CPU.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    # Security headers are included per location, not here: a location with
    # no add_header of its own would inherit them, and /api must send only the
    # API's own set (twice-sent headers are a finding of their own).

    # ── 1. NHI backend ────────────────────────────────────────────────
    # This upstream serves the /api prefix itself, so the path is forwarded
    # unchanged - no rewrite.
    # Only API version 1 exists. Any other /api/ path (for example /api/v2/)
    # is answered here with 404, so nothing about other upstream routes leaks
    # and no request reaches the backend for a version it does not serve.
    location ^~ /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/json;
        return 404 '{"success":false,"error":"ROUTE_NOT_FOUND","message":"route not found"}';
    }

    location ^~ /api/v1/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # A scan listing can take a while to answer; the UI holds a skeleton
        # while it does.
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
        # The API sends its own security headers (stricter than the page's:
        # default-src 'none') and Cache-Control: no-store. Adding nginx's here
        # would send every one of them twice.
    }

    # ── 1b. Discovery scanner (scan start / status) ───────────────────
    # The console calls the scanner's own scan API; it goes through here so the
    # browser stays same-origin (no CORS) and no host name is built into the
    # bundle. The scanner is authenticated by the user's bearer token alone,
    # forwarded as it came: no API key is configured or sent.
    location ^~ /scan-api/ {
        set $scan_upstream "${DISCOVERY_UPSTREAM}";
        rewrite ^/scan-api/(.*)$ /$1 break;
        proxy_pass $scan_upstream;

        proxy_http_version 1.1;
        # An https upstream (an ALB, CloudFront or API gateway host) picks its
        # certificate by server name; without SNI the handshake fails and the
        # browser sees 502.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # No API key: the bearer token is the credential. A key a browser sends
        # itself is not passed on either (an empty value drops the header).
        proxy_set_header X-API-Key "";
        # The scanner's own copies of these are replaced by ours below, and
        # nothing about the scanner's software is passed on.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cache-Control;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ── 2. The single-page app ──────────────────────────────────────────────
    # Fingerprinted assets are immutable: the filename changes whenever the
    # contents do, so a year of caching can never serve a stale one.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        # Set through add_header rather than `expires`, which emits a
        # Cache-Control of its own and would send the header twice.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Brand files are referenced by stable names, so they get a short cache
    # with revalidation rather than a year.
    location /brand/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
    }

    # index.html is never cached: it is the document that names which asset
    # bundle to load, so a cached copy pins a browser to a deployment that no
    # longer exists.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    # Client-side routing: /genome/some-identity is a route, not a file, so
    # anything not on disk is answered with the app shell.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ── Health ──────────────────────────────────────────────────────────────
    # Answered by nginx alone, with no upstream call. This reports whether the
    # web tier is serving, which is what a liveness probe asks. Whether the
    # APIs are reachable is a different question, and the app already answers
    # that on screen rather than by failing to start.
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # Source maps and source files are never built into the image; if one ever
    # is, it is still not served.
    location ~* \.(map|jsx|tsx?|mjs\.map|env|lock|log)$ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # Do not serve dotfiles, whatever ends up in the image.
    location ~ /\. {
        include /etc/nginx/snippets/security-headers.conf;
        deny all;
        access_log off;
        log_not_found off;
    }
}
