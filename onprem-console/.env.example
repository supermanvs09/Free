# On-premises Code & CI/CD console. Copy to .env and fill in the REQUIRED values.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres password (docker compose). Without compose, set ONPREM_DATABASE_URL instead:
#   ONPREM_DATABASE_URL=postgres://user:pass@host:5432/onprem?sslmode=require
ONPREM_DB_PASSWORD=
# Signs sign-in sessions. At least 32 characters: openssl rand -hex 32
ONPREM_JWT_SECRET=
# Encrypts saved tokens, private keys and webhook secrets (AES-256-GCM).
# base64 of 32 random bytes: openssl rand -base64 32
# Back it up: losing it means re-entering every connection's secret.
ONPREM_ENCRYPTION_KEY=
# The first admin, created once on first start when there is no user yet.
# Password: 12-72 characters with upper, lower, number and symbol.
ONPREM_ADMIN_EMAIL=
ONPREM_ADMIN_PASSWORD=

# ── Recommended ─────────────────────────────────────────────────────────────
# The address GitHub, Bitbucket and Jenkins use to reach this console; webhook
# URLs shown in the console start with it. Empty: the browser's own address.
ONPREM_PUBLIC_URL=
# Business hours and time zone for "build outside business hours" flags.
ONPREM_BUSINESS_HOURS=8-19
ONPREM_TIMEZONE=UTC

# ── Optional ────────────────────────────────────────────────────────────────
# Web port on the host (docker compose).
ONPREM_HTTP_PORT=8443
# Session length in hours.
ONPREM_SESSION_HOURS=8
# Files over this size are skipped by scans, in KB.
ONPREM_SCAN_MAX_FILE_KB=1024
# A full scan reads at most this many files per repository (pushes are always scanned).
ONPREM_SCAN_MAX_FILES_PER_REPO=5000
# Full scan (or Jenkins sync) of every connected source every N hours, so the
# console stays current where webhooks cannot reach it. 0 turns it off.
ONPREM_SCAN_EVERY_HOURS=24
# Only when the web app is served from another origin than the API (CORS).
ONPREM_ALLOWED_ORIGIN=
# API listen address inside its container.
ONPREM_ADDR=:8090
