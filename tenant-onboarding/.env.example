# Copy this file to ".env" in the folder you start the service from. It is loaded
# automatically: no need to export anything. A value already set in the real
# environment (for example by your container platform) wins over this file.
# Set ENV_FILE=/path/to/file to read a different file.

# The database (the same one your backend uses). Or set DATABASE_URL instead.
DB_HOST=
DB_PORT=5432
DB_NAME=nhi_db
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Optional
PORT=8090
GLOBAL_SCHEMA=nhi_global
# Every company gets <name>.<DOMAIN_SUFFIX> as its domain (the database wants a dotted name).
DOMAIN_SUFFIX=nhi.local

# Sign-in needs nothing here: super admins live in the database (run sql/super_admin.sql once).
